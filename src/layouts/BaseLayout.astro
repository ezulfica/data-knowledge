---
import Header from '../components/Header.astro';
const { title = 'Data Knowledge', description = 'A living library for data and AI engineering.' } = Astro.props;
---
<!doctype html><html lang="fr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="color-scheme" content="light dark" /><title>{title}</title></head><body><Header /><main><slot /></main><footer>Data Knowledge · Explore, understand, practise.</footer></body></html>
<style is:global>
  :root { --bg:#faf9f6; --surface:#fff; --text:#1c2422; --muted:#68716e; --line:#e4e4df; --accent:#216f61; --accent-soft:#e4f0ec; --code:#f0f1ed; }
  :root[data-theme="dark"] { --bg:#121716; --surface:#19201e; --text:#edf2ef; --muted:#aab5b0; --line:#303a36; --accent:#76c6b4; --accent-soft:#1d3933; --code:#202927; }
  *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--bg);color:var(--text);font:16px/1.65 Inter,ui-sans-serif,system-ui,sans-serif} a{color:inherit;text-decoration:none} a:hover{color:var(--accent)} main{min-height:calc(100vh - 140px)} footer{max-width:1180px;margin:auto;padding:32px 24px;color:var(--muted);border-top:1px solid var(--line);font-size:.9rem}.site-header{height:72px;display:flex;align-items:center;gap:42px;max-width:1180px;margin:auto;padding:0 24px;border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:-.04em;font-size:1.12rem;white-space:nowrap}.brand span{color:var(--accent)}nav{display:flex;gap:24px;font-size:.92rem}nav a{color:var(--muted)}.header-actions{margin-left:auto;display:flex;gap:16px;align-items:center}.search-link{color:var(--muted);font-size:.9rem}.theme-toggle{border:1px solid var(--line);background:transparent;color:var(--text);width:32px;height:32px;border-radius:50%;cursor:pointer}.wrap{max-width:1180px;margin:auto;padding:72px 24px}.eyebrow{color:var(--accent);font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.lede{font-size:1.18rem;color:var(--muted);max-width:650px}.button{display:inline-block;background:var(--text);color:var(--bg);padding:11px 17px;border-radius:7px;font-size:.92rem}.button:hover{color:var(--bg);opacity:.86}.card{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:24px}.card h3{margin:.35rem 0 .5rem;letter-spacing:-.025em}.meta{font-size:.82rem;color:var(--muted)}.tag{font-size:.75rem;border:1px solid var(--line);border-radius:99px;padding:3px 9px;color:var(--muted)}.tag-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:16px}.section-title{font-size:1.5rem;letter-spacing:-.035em;margin:0 0 22px}.grid{display:grid;gap:16px}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:repeat(2,1fr)}.page-title{font-size:clamp(2.5rem,6vw,5rem);line-height:1.02;letter-spacing:-.065em;max-width:820px;margin:12px 0 20px}input,select,textarea{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:11px}textarea{width:100%;min-height:180px;resize:vertical}@media(max-width:720px){.site-header{gap:15px;height:64px}.site-header nav{gap:13px;font-size:.82rem}.search-link span{display:none}.wrap{padding:46px 20px}.grid-3,.grid-2{grid-template-columns:1fr}.page-title{font-size:2.7rem}.header-actions{gap:8px}}
</style>
