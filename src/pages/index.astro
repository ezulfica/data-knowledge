---
import BaseLayout from '../layouts/BaseLayout.astro'; import ContentCard from '../components/ContentCard.astro'; import { getCollection } from 'astro:content';
const articles = (await getCollection('articles')).sort((a,b)=>(b.data.updatedAt || b.data.publishedAt).getTime()-(a.data.updatedAt || a.data.publishedAt).getTime());
const news = (await getCollection('news')).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
const exercises = await getCollection('exercises');
---
<BaseLayout title="Data Knowledge — Explore, understand, practise">
  <section class="wrap hero"><p class="eyebrow">A personal knowledge system</p><h1 class="page-title">Explore what’s new.<br/><em>Understand</em> how it works.</h1><p class="lede">Une bibliothèque vivante pour relier les évolutions de la data aux concepts qui permettent de les comprendre — puis les mobiliser dans des situations réelles.</p><div class="hero-actions"><a class="button" href="/data-knowledge/discover/">Explorer les nouveautés</a><a href="/data-knowledge/learn/">Parcourir la bibliothèque →</a></div></section>
  <section class="wrap compact"><div class="section-head"><div><p class="eyebrow">Discover</p><h2 class="section-title">Dernières découvertes</h2></div><a href="/data-knowledge/discover/">Voir toutes →</a></div><div class="grid grid-2">{news.map(entry => <ContentCard entry={entry} kind="news" />)}</div></section>
  <section class="wrap compact"><div class="section-head"><div><p class="eyebrow">Learn</p><h2 class="section-title">Continuer à apprendre</h2></div><a href="/data-knowledge/learn/">Explorer →</a></div><div class="grid grid-3">{articles.map(entry => <ContentCard entry={entry} />)}</div></section>
  <section class="wrap compact practice-callout"><div><p class="eyebrow">Practice</p><h2 class="section-title">Mettre ses connaissances à l’épreuve</h2><p>Réfléchissez à un cas réel avant de comparer votre raisonnement à une correction argumentée.</p></div><a class="button" href={`/data-knowledge/practice/${exercises[0].id}/`}>Commencer l’exercice</a></section>
</BaseLayout>
<style>.hero{padding-top:110px;padding-bottom:94px}.hero em{font-family:Georgia,serif;font-weight:400;color:var(--accent)}.hero-actions{display:flex;align-items:center;gap:22px;margin-top:32px;font-size:.92rem}.compact{padding-top:42px;padding-bottom:42px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:22px}.section-head>a{font-size:.9rem;color:var(--accent)}.practice-callout{display:flex;justify-content:space-between;align-items:center;background:var(--accent-soft);border-radius:12px;margin-top:30px;margin-bottom:70px}.practice-callout p{max-width:600px;color:var(--muted);margin:0}@media(max-width:720px){.hero{padding-top:70px}.hero-actions,.practice-callout{align-items:flex-start;flex-direction:column}.practice-callout{margin-inline:20px;padding:30px 24px}}</style>
