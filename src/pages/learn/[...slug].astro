---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import { label, date } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('articles')).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content, headings } = await render(entry);
const related = (await getCollection('articles')).filter(item => entry.data.relatedArticles.includes(item.id));
---
<BaseLayout title={`${entry.data.title} — Data Knowledge`} description={entry.data.description}><article class="article-wrap"><aside class="article-context"><p class="eyebrow">{label(entry.data.domain)}</p><p>{entry.data.technology}</p><div class="tag-row">{entry.data.tags.map(tag=><span class="tag">{tag}</span>)}</div></aside><div class="article-main"><header><p class="meta">Mis à jour le {date(entry.data.updatedAt || entry.data.publishedAt)} · {entry.data.difficulty}</p><h1>{entry.data.title}</h1><p class="intro">{entry.data.description}</p></header><div class="prose"><Content /></div>{related.length > 0 && <section class="related"><p class="eyebrow">À poursuivre</p><h2>Articles associés</h2>{related.map(item=><a href={`/data-knowledge/learn/${item.id}/`}>{item.data.title} →</a>)}</section>}</div><aside class="toc"><p class="eyebrow">Sommaire</p>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</aside></article></BaseLayout>
<style is:global>.article-wrap{max-width:1280px;margin:auto;padding:64px 24px;display:grid;grid-template-columns:180px minmax(0,720px) 180px;gap:50px}.article-context,.toc{font-size:.85rem;color:var(--muted);position:sticky;top:30px;height:max-content}.toc{border-left:1px solid var(--line);padding-left:20px;display:grid;gap:9px}.toc a{color:var(--muted)}.article-main h1{font-size:clamp(2.4rem,5vw,4.4rem);line-height:1.06;letter-spacing:-.06em;margin:12px 0 20px}.intro{font-size:1.22rem;line-height:1.55;color:var(--muted);margin-bottom:52px}.prose{font-size:1.04rem}.prose h2{font-size:1.75rem;letter-spacing:-.035em;margin:64px 0 16px}.prose h3{margin-top:36px}.prose p,.prose li{max-width:68ch}.prose code{font-family:'SFMono-Regular',Consolas,monospace;background:var(--code);padding:.12em .32em;border-radius:4px;font-size:.88em}.prose pre{background:var(--code);padding:20px;border-radius:9px;overflow:auto}.prose pre code{padding:0}.prose blockquote{margin:28px 0;padding:8px 20px;border-left:3px solid var(--accent);color:var(--muted)}.prose table{width:100%;border-collapse:collapse;font-size:.92rem}.prose th,.prose td{border:1px solid var(--line);padding:9px;text-align:left}.related{margin-top:70px;border-top:1px solid var(--line);padding-top:28px}.related a{display:block;color:var(--accent);margin:10px 0}@media(max-width:950px){.article-wrap{grid-template-columns:minmax(0,720px)}.article-context{position:static;display:flex;gap:12px;align-items:center}.toc{display:none}} </style>
