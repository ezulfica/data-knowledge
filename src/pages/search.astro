---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Recherche — Data Knowledge"><section class="wrap search-page"><p class="eyebrow">Search</p><h1 class="page-title">Retrouver un concept.</h1><div id="search"></div></section></BaseLayout>
<script is:inline>import('/data-knowledge/pagefind/pagefind.js').then(async pagefind => { const search = document.querySelector('#search'); const ui = document.createElement('div'); ui.innerHTML = '<input type="search" placeholder="Rechercher dans la bibliothèque" aria-label="Recherche" autofocus /><div class="results"></div>'; search?.append(ui); const input = ui.querySelector('input'); const results = ui.querySelector('.results'); input?.addEventListener('input', async () => { const query = input.value.trim(); if (!query) { results.innerHTML=''; return; } const data = await pagefind.search(query); const items = await Promise.all(data.results.slice(0,10).map(r=>r.data())); results.innerHTML=items.map(item=>`<a class="result" href="${item.url}"><strong>${item.meta.title}</strong><span>${item.excerpt}</span></a>`).join(''); }); });</script>
<style>.search-page #search{max-width:720px;margin-top:45px}.search-page input{width:100%;font-size:1.05rem}.results{margin-top:15px}.result{display:block;border-bottom:1px solid var(--line);padding:16px 0}.result strong{display:block}.result span{font-size:.9rem;color:var(--muted)}</style>
