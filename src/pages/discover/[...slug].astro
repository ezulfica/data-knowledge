---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import { label, date } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('news')).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry); const related = (await getCollection('articles')).filter(a=>entry.data.relatedArticles.includes(a.id));
---
<BaseLayout title={`${entry.data.title} — Data Knowledge`}><article class="news-article"><p class="eyebrow">Discover · {label(entry.data.domain)}</p><p class="meta">Publié le {date(entry.data.originalPublishedAt)} · analysé le {date(entry.data.publishedAt)}{entry.data.isDemo && ' · Démonstration'}</p><h1>{entry.data.title}</h1><p class="intro">{entry.data.description}</p><a class="source" href={entry.data.source.url} target="_blank" rel="noreferrer">Source officielle : {entry.data.source.title} ↗</a><div class="prose"><Content /></div>{related.length>0 && <section class="related"><p class="eyebrow">Comprendre les concepts</p>{related.map(a=><a href={`/data-knowledge/learn/${a.id}/`}>{a.data.title} →</a>)}</section>}</article></BaseLayout>
<style is:global>.news-article{max-width:760px;margin:auto;padding:72px 24px}.news-article h1{font-size:clamp(2.4rem,5vw,4.2rem);letter-spacing:-.06em;line-height:1.06;margin:14px 0}.source{display:inline-block;margin:10px 0 36px;color:var(--accent);font-size:.9rem}.news-article .related{margin-top:60px;border-top:1px solid var(--line);padding-top:26px}.news-article .related a{display:block;color:var(--accent);margin:9px 0}</style>
