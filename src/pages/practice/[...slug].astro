---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import { label } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('exercises')).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
---
<BaseLayout title={`${entry.data.title} — Practice`}><section class="exercise-wrap"><p class="eyebrow">Practice · {label(entry.data.domain)}</p><h1>{entry.data.title}</h1><p class="intro">{entry.data.description}</p><section class="scenario"><p class="eyebrow">Contexte</p><p>{entry.data.scenario}</p></section><h2>Votre raisonnement</h2><textarea id="answer" placeholder="Posez vos hypothèses, proposez une approche, puis expliquez les compromis…"></textarea><div class="actions"><button class="save" type="button">Conserver localement</button><button class="reveal" type="button">Voir la correction</button></div><section class="answer" hidden><p class="eyebrow">Éléments attendus</p><ul>{entry.data.expected.map(item=><li>{item}</li>)}</ul><p>{entry.data.correction}</p></section></section></BaseLayout>
<script define:vars={{ id: entry.id }}>const area=document.querySelector('#answer'); const answer=document.querySelector('.answer'); document.querySelector('.reveal')?.addEventListener('click',()=>{answer.hidden=false; answer.scrollIntoView({behavior:'smooth'});}); document.querySelector('.save')?.addEventListener('click',()=>{localStorage.setItem(`data-knowledge:${id}`, area.value);}); area.value=localStorage.getItem(`data-knowledge:${id}`)||'';</script>
<style>.exercise-wrap{max-width:760px;margin:auto;padding:72px 24px}.exercise-wrap h1{font-size:clamp(2.4rem,5vw,4.2rem);line-height:1.06;letter-spacing:-.06em}.scenario{margin:40px 0;padding:24px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.exercise-wrap h2{font-size:1.4rem;margin-top:40px}.actions{display:flex;justify-content:space-between;margin-top:14px}.actions button{font:inherit;padding:10px 14px;border:1px solid var(--line);border-radius:7px;background:var(--surface);color:var(--text);cursor:pointer}.actions .reveal{background:var(--text);color:var(--bg)}.answer{margin-top:45px;padding:24px;border-radius:9px;background:var(--accent-soft)}.answer li{margin:7px 0}</style>
